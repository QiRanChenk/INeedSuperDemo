# OpenAI-compatible endpoint. Can also be set in the shell UI (settings), which takes precedence.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# Shell port
PORT=3000
# docker compose: host port mapped to the container
# HOST_PORT=18788
# Demo previews + share links run on a second port (another origin, isolated from the shell). Default: PORT+1
# SUPERDEMO_DEMO_PORT=3001
# docker compose: host port for it
# DEMO_HOST_PORT=18789
# Public address of that port when reached through a domain / reverse proxy (can also be set in the UI)
# SUPERDEMO_DEMO_URL=https://demo.example.com:8789

# Listen address. Default 127.0.0.1 (this machine only). The shell can run commands through the AI agent, so
# listening beyond loopback (e.g. HOST=0.0.0.0) requires an access password (HTTP Basic auth, any username).
# HOST=0.0.0.0
# SUPERDEMO_PASSWORD=change-me-to-a-long-random-string
# Extra host names allowed without a password (comma separated), e.g. a local reverse proxy name.
# SUPERDEMO_ALLOWED_HOSTS=
