# OpenAI-compatible endpoint. Can also be set in the shell UI (settings), which takes precedence.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# Shell port
PORT=3000
# docker compose: host port mapped to the container
# HOST_PORT=18788
# Demo previews + share links run on a second port (another origin, isolated from the shell). Default: PORT+1
# SUPERDEMO_DEMO_PORT=3001
# docker compose: host port for it
# DEMO_HOST_PORT=18789
# Public address of that port when reached through a domain / reverse proxy (can also be set in the UI)
# SUPERDEMO_DEMO_URL=https://demo.example.com:8789

# Addresses. Empty = the old behaviour (demo origin = this host name + the demo port).
# SUPERDEMO_PUBLIC_URL=https://demo.example.com            # the shell via the public (relay) address; links handed out
# SUPERDEMO_DEMO_PUBLIC_URL=https://demo-box.example.com   # the demo origin via the public address (share links)
# SUPERDEMO_DIRECT_URL=https://demo6.example.com:5002      # 直连: the shell reached directly (IPv6); the UI moves there
# SUPERDEMO_DEMO_DIRECT_URL=https://demo-box6.example.com:5002  # the demo origin reached directly (previews there)
# SUPERDEMO_APP_ORIGINS=https://old.example.com:8788       # other addresses of the shell (OIDC redirect, Origin check)
# SUPERDEMO_TRUST_PROXY=1                                  # behind a reverse proxy: trust X-Forwarded-Proto / X-Real-IP

# Listen address. Default 127.0.0.1 (this machine only). The shell can run commands through the AI agent, so
# listening beyond loopback (e.g. HOST=0.0.0.0) requires a sign-in method: 统一登录 (OIDC) and/or an access password.
# HOST=0.0.0.0
# 统一登录 (Casdoor / any OIDC provider): authorization code + PKCE. Redirect URI: <address>/auth/oidc/callback
# SUPERDEMO_OIDC_ISSUER=https://auth.example.com
# SUPERDEMO_OIDC_CLIENT_ID=
# SUPERDEMO_OIDC_CLIENT_SECRET=
# SUPERDEMO_OIDC_INTERNAL_URL=http://192.168.1.10:8001     # optional: token/userinfo calls over the LAN
# SUPERDEMO_OIDC_ORGANIZATION=internal                     # optional: refuse accounts of other Casdoor organizations
# SUPERDEMO_SESSION_HOURS=12                               # session after 统一登录 (renewed silently through the IdP)
# Shared access password (login page fallback, rate-limited):
# SUPERDEMO_PASSWORD=change-me-to-a-long-random-string
# SUPERDEMO_PASSWORD_SESSION_HOURS=168
# Extra host names allowed without any sign-in method (comma separated), e.g. a local reverse proxy name.
# SUPERDEMO_ALLOWED_HOSTS=
